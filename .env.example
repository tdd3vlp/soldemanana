BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4o
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=450
OPENAI_CORRECTION_MAX_TOKENS=650
OPENAI_SUMMARY_MAX_TOKENS=160
DIALOG_HISTORY_SIZE=4
DIALOG_MESSAGE_CHAR_LIMIT=500
MEMORY_SUMMARY_INTERVAL=12
AI_INPUT_COST_PER_1M=0.15
AI_OUTPUT_COST_PER_1M=0.60

DATABASE_URL=postgresql+asyncpg://habla:habla_password@localhost:5432/habla_db

REDIS_URL=redis://localhost:6379/0

WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook/bot
WEBHOOK_SECRET=your_webhook_secret_here

WEB_APP_BASE_URL=https://your-domain.com
SUBSCRIPTION_WEB_APP_PATH=/subscription

YOOKASSA_SHOP_ID=your_yookassa_shop_id
YOOKASSA_SECRET_KEY=your_yookassa_secret_key

API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO
ENVIRONMENT=development
